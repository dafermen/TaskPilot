{
  "homepage": "https://taskpilot.innovalogic.tech",
  "name": "taskpilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predeploy": "npm run verify:release",
    "deploy": "gh-pages -d dist",
    "predev": "npm run docs:build",
    "dev": "vite --host 127.0.0.1",
    "start": "npm run dev -- --port 5179",
    "build": "npm run docs:build && vite build",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:browser": "node scripts/check-docs-browser.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:preview": "npm run build && vite preview --host 127.0.0.1",
    "test": "node --test",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:property": "node --test \"test/property/*.test.js\"",
    "test:fuzz": "node --test \"test/fuzz/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "test:contract": "node --test \"test/contract/*.test.js\"",
    "test:performance": "node --test \"test/performance/*.test.js\"",
    "test:e2e": "node scripts/check-app-browser.mjs",
    "performance:budget": "node scripts/check-performance.mjs",
    "verify:release": "npm test && npm run build && npm run performance:budget && npm run test:e2e && npm run docs:check && npm run docs:browser && npm audit --audit-level=moderate",
    "preview": "vite preview --host 127.0.0.1",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@vitejs/plugin-react": "6.0.3",
    "lucide-react": "1.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "gh-pages": "^6.3.0",
    "markdown-it": "15.0.1",
    "playwright-core": "1.63.0"
  }
}
